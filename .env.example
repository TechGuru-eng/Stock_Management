# Copy to .env.local and fill in from your Supabase project settings.
# Use ONLY the public anon / publishable key here. Never put a service-role key in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# The PUBLIC licence key (safe to ship; it can only verify, never sign). Get it with:
#   curl -s -X POST https://YOUR-PROJECT.supabase.co/functions/v1/licence -H "Content-Type: application/json" -d '{"action":"public-key"}'
# and paste the value of "publicJwk" (one line, in single quotes).
VITE_LICENCE_PUBLIC_KEY='{"kty":"EC","crv":"P-256","x":"...","y":"..."}'
